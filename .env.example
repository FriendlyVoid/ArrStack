# User and Group IDs for container permissions
# Run 'id -u' to get your user ID (PUID) and 'id -g' to get your group ID (PGID)
# These ensure files created by containers are owned by your user, not root
PUID=1000
PGID=1000

# UMASK controls default file permissions (optional)
# 002 = files are readable/writable by owner and group, readable by others
# 022 = files are readable/writable by owner, readable by group and others
UMASK=002

# Timezone for container - Change to your time zone,
# choose from the list here: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Plex claim token (optional, only needed for first-time setup)
# Option 1: Leave empty, start the stack, then sign in at http://your-server-ip:32400/web
# Option 2: Get a claim token at https://www.plex.tv/claim/ (valid for 4 minutes),
#           paste it below, then immediately run 'docker compose up -d'

PLEX_CLAIM=


# Media share location - folder or drive for media files. this will be shared across
# all docker containers to keep the folder structure consistent

MEDIA_SHARE=

# Appdata folder - location for app config files.  This will be shared across all docker containers
# to keep the folder structure consistent and keep all config files in one place

APPDATA_FOLDER=

# Web UI Ports - change these if you need to avoid port conflicts
# Media Players
JELLYFIN_WEBUI_PORT=8096      # default: 8096

# Downloaders
SABNZBD_WEBUI_PORT=8080       # default: 8080
QBITTORRENT_WEBUI_PORT=8112   # default: 8112

# Arr Apps
PROWLARR_WEBUI_PORT=9696      # default: 9696
RADARR_WEBUI_PORT=7878        # default: 7878
SONARR_WEBUI_PORT=8989        # default: 8989
SONARR_ANIME_WEBUI_PORT=8990  # default: 8990
BAZARR_WEBUI_PORT=6767        # default: 6767

# Monitors and Utilities
NOTIFIARR_WEBUI_PORT=5454     # default: 5454
OVERSEERR_WEBUI_PORT=5055     # default: 5055
TAUTULLI_WEBUI_PORT=8181      # default: 8181

# Gluetun Settings
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=openvpn
OPENVPN_USER=        # Use +pmp after your username
OPENVPN_PASSWORD=
SERVER_COUNTRIES="United States"   # Preferred VPN server locations
VPN_PORT_FORWARDING=on                 # Enable port forwarding

# This command auto-replaces {{PORTS}} with the actual forwarded port
# this will allow qbittorrent to use the forwarded port from gluetun automatically on startup

VPN_PORT_FORWARDING_UP_COMMAND=/bin/sh -c '/usr/bin/wget -O- --retry-connrefused --post-data "json={\"listen_port\":{{PORTS}}}" http://127.0.0.1:${QBITTORRENT_WEBUI_PORT}/api/v2/app/setPreferences 2>&1'

# ---- Cloudflare tunnel token - optional, but required for cloudflare zero trust tunnel if you want to set up cloudflared for remote access ----
# instructions to create tunnel and get token: https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/install-and-setup/tunnel-guide/

# CLOUDFLARE_TUNNEL_TOKEN=

